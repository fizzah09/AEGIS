# Local configuration. Do not commit real credentials.
# API key can also be set from the dashboard and will remain in process memory.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Optional: local login (use RUN_SECURE.bat for simpler setup)
AEGIS_ADMIN_PASSWORD=
AEGIS_REVIEWER_PASSWORD=
AEGIS_GOOGLE_CLIENT_ID=
AEGIS_GOOGLE_CLIENT_SECRET=
# NEVER set this to 1 for the competition or a real student mailbox.
AEGIS_ENABLE_LIVE_GMAIL_SEND=0
